# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (Gemini) — model names are confirmed on build day.
GEMINI_API_KEY=
GEMINI_MODEL=
# one model, or several comma-separated, tried in order when the one before is out of quota
GEMINI_FALLBACK_MODEL=
GEMINI_EMBEDDING_MODEL=

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dorar relay (Cloudflare Worker in worker/) - only needed if direct calls to dorar.net are blocked on your network
DORAR_RELAY_URL=
DORAR_RELAY_KEY=

# Secret that signs Turath excerpts before they can be machine-translated (any long random string)
TRANSLATE_SIGNING_KEY=

# All AI calls of the whole site in one UTC day (src/lib/rateLimit.ts), for a key with billing on; empty or 0 = no
# site-wide limit (on the free tier Gemini stops by itself and bills nothing). Each client has its own limits regardless.
DAILY_AI_LIMIT=
