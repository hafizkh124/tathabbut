# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (Gemini) — model names are confirmed on build day.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_EMBEDDING_MODEL=

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dorar relay (Cloudflare Worker in worker/) - only needed if direct calls to dorar.net are blocked on your network
DORAR_RELAY_URL=
DORAR_RELAY_KEY=

# Secret that signs Turath excerpts before they can be machine-translated (any long random string)
TRANSLATE_SIGNING_KEY=
